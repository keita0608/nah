# ── nah-watcher 環境変数テンプレート ──────────────────────────────
# このファイルをコピーして .env を作成し、実値を埋めてください。
#   cp .env.example .env
# .env は .gitignore 済みなので、秘密情報がコミットされることはありません。

# OpenSea API キー（必須）
# 取得方法:
#   curl -s -X POST https://api.opensea.io/api/v2/auth/keys | jq -r '.api_key'
OPENSEA_API_KEY=

# Slack Incoming Webhook URL（必須）
# 例: https://hooks.slack.com/services/T000/B000/xxxxxxxx
SLACK_WEBHOOK_URL=

# ETH→JPY レート（任意・数値）
# 設定すると通知に「（約¥◯◯）」を併記します。未設定なら省略されます。
# 例: ETH_JPY=255000
ETH_JPY=
